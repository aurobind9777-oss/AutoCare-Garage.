      "required": ["invoiceId", "invoiceNumber", "bookingId", "garageId", "customerId", "amount", "method", "status", "verifiedBy", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Garage-specific operating expense record.",
      "type": "object",
      "properties": {
        "garageId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "garageManagerId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["Spare Parts Purchases", "Mechanic Salaries", "Rent", "Electricity", "Equipment", "Maintenance", "Other"] },
        "description": { "type": "string", "minLength": 2, "maxLength": 300 },
        "amount": { "type": "number" },
        "expenseDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["garageId", "category", "description", "amount", "expenseDate", "recordedBy", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer review for a completed service booking.",
      "type": "object",
      "properties": {
        "garageId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "garageManagerId": { "type": "string", "maxLength": 128 },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["garageId", "bookingId", "customerId", "customerName", "rating", "comment", "verified", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support ticket routed to the relevant garage.",
      "type": "object",
      "properties": {
        "ticketCode": { "type": "string", "minLength": 4, "maxLength": 32 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "garageId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "garageManagerId": { "type": "string", "maxLength": 128 },
        "bookingId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "minLength": 3, "maxLength": 180 },
        "message": { "type": "string", "minLength": 3, "maxLength": 1500 },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved", "Closed"] },
        "replies": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketCode", "customerId", "customerName", "garageId", "subject", "message", "priority", "status", "replies", "createdAt", "updatedAt"]
    },
    "SupportInternalNote": {
      "title": "SupportInternalNote",
      "description": "Private staff-only note for support tickets, invisible to customers.",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "garageId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "garageManagerId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "note": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketId", "garageId", "authorId", "note", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real Firestore-based in-app notification for customer, manager, or Super Admin.",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipientRole": { "type": "string", "enum": ["super_admin", "garage_manager", "mechanic", "customer"] },
        "garageId": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "message": { "type": "string", "minLength": 2, "maxLength": 500 },
        "type": { "type": "string", "maxLength": 48 },
        "relatedBookingId": { "type": "string", "maxLength": 128 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "recipientRole", "title", "message", "type", "isRead", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable platform audit trail for critical actions.",
      "type": "object",
      "properties": {
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorRole": { "type": "string", "minLength": 2, "maxLength": 32 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "action": { "type": "string", "minLength": 2, "maxLength": 120 },
        "targetCollection": { "type": "string", "minLength": 2, "maxLength": 64 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "garageId": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorId", "actorRole", "action", "targetCollection", "targetId", "details", "createdAt"]
    },
    "PlatformSetting": {
      "title": "PlatformSetting",
      "description": "Global platform configuration managed by Super Admin.",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "tagline": { "type": "string", "maxLength": 200 },
        "currency": { "type": "string", "maxLength": 16 },
        "defaultTaxRate": { "type": "number" },
        "supportEmail": { "type": "string", "maxLength": 160 },
        "supportPhone": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessName", "tagline", "currency", "defaultTaxRate", "updatedAt"]
    }
  },
